# HTTP server
PORT=8787

# Postgres. docker-compose.yml provisions this locally.
DATABASE_URL=postgres://zenith:zenith@localhost:5432/zenith

# Redis, used by the webhook queue.
REDIS_URL=redis://localhost:6379

# Stellar. Testnet only. Never point this at mainnet.
STELLAR_NETWORK=testnet
HORIZON_URL=https://horizon-testnet.stellar.org
NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Base URL the hosted checkout page runs at. Used to build checkout links.
CHECKOUT_BASE_URL=http://localhost:3000

# Optional funded Testnet secret for integration tests. Never commit a real one.
STELLAR_SECRET=
